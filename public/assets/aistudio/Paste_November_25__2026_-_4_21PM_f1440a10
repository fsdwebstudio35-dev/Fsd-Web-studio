<div class="w-full max-w-md max-h-[85vh] bg-surface rounded-t-2xl shadow-2xl flex flex-col transform translate-y-full transition-transform duration-300 ease-out overflow-hidden" id="modalSheet">
<!-- Modal Sticky Header -->
<div class="p-space-md bg-surface flex items-center justify-between border-b border-outline-variant/30">
<div class="flex flex-col min-w-0">
<span class="font-label-caps text-[10px] text-secondary font-bold uppercase tracking-wider truncate" id="modalCategory">Category</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface truncate" id="modalTitle">Case Study Title</h3>
</div>
<button class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors shrink-0" onclick="closeCaseStudy()" type="button">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<!-- Modal Body (Scrollable) -->
<div class="p-space-md flex-1 overflow-y-auto flex flex-col gap-space-md">
<!-- Client Background & Problem Statement -->
<div class="flex flex-col gap-1.5">
<div class="flex items-center gap-1 text-on-surface font-semibold text-[13px]">
<span class="material-symbols-outlined text-secondary text-[18px]">problem</span>
<span>Problem &amp; Challenge</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed" id="modalProblem">
            Description of the client challenge.
          </p>
</div>
<!-- Solution & Tech Stack -->
<div class="flex flex-col gap-2 p-3 rounded-xl bg-surface-container-lowest shadow-sm">
<div class="flex items-center gap-1 text-on-surface font-semibold text-[13px]">
<span class="material-symbols-outlined text-secondary text-[18px]">terminal</span>
<span>Engineered Architecture</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant" id="modalSolution">
            Technical solution outline.
          </p>
<div class="flex flex-wrap gap-1.5 pt-1" id="modalStack">
<!-- Dynamic stack tags -->
</div>
</div>
<!-- Measurable Business Outcomes -->
<div class="flex flex-col gap-2">
<div class="flex items-center gap-1 text-on-surface font-semibold text-[13px]">
<span class="material-symbols-outlined text-secondary text-[18px]">analytics</span>
<span>Quantified Impact</span>
</div>
<div class="grid grid-cols-2 gap-2" id="modalMetrics">
<!-- Dynamic stats metrics -->
</div>
</div>
<!-- Client Quote & Testimonial -->
<div class="p-3.5 rounded-xl bg-surface-container-low flex flex-col gap-2">
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-secondary text-[18px]">format_quote</span>
<span class="font-label-caps text-[11px] text-secondary font-bold uppercase">Executive Feedback</span>
</div>
<blockquote class="font-body-sm text-body-sm text-on-surface italic" id="modalQuote">
            "Client quote here..."
          </blockquote>
<span class="font-label-caps text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold" id="modalAuthor">
            — Name, Title
          </span>
</div>
<!-- Modal Action Link -->
<div class="pt-2 pb-6">
<button class="w-full h-11 rounded-full bg-primary text-on-primary font-label-button text-label-button flex items-center justify-center gap-1.5 shadow-md" onclick="closeCaseStudy()" type="button">
<span>Close Overview</span>
</button>
</div>
</div>
</div>
</div>
</div>
<script>
  // Case Study Details Data Store
  const CASE_STUDIES = {
    finvantage: {
      title: "FinVantage Global OS",
      category: "Fintech Web App & Security Architecture",
      problem: "FinVantage was experiencing excessive query latencies on their institutional liquidity dashboard, resulting in drop-offs and poor user engagement across trading desks.",
      solution: "Engineered an ultra-low-latency real-time dashboard powered by WebSockets, biometrics authentication fallback, and high-frequency canvas-rendered charting.",
      stack: ["React 19", "Tailwind CSS", "Rust WASM", "GraphQL", "Redis Cache"],
      metrics: [
        { label: "Query Latency", value: "0.4s" },
        { label: "Active Retention", value: "+210%" },
        { label: "Daily Transfers", value: "$4.8M" },
        { label: "Error Budget", value: "99.99%" }
      ],
      quote: "FSD took our complex financial transaction pipelines and packaged them into an interface that feels like high art. Our clients are transacting 3x more often.",
      author: "Alex Rivero — CTO at FinVantage"
    },
    aurelia: {
      title: "Aurelia Maison Luxury Store",
      category: "Headless E-Commerce & Micro-Interactions",
      problem: "The brand's previous monolithic store suffered 3.8s mobile load times, resulting in low checkout conversions among luxury global shoppers.",
      solution: "Built a fully headless Next.js flagship utilizing Shopify Storefront GraphQL, client-side lookbook interactions, instant Apple Pay shortcuts, and global CDN asset edge routing.",
      stack: ["Next.js", "Tailwind CSS", "Shopify GraphQL", "Framer Motion", "Stripe API"],
      metrics: [
        { label: "First Quarter GMV", value: "€2.4M" },
        { label: "Mobile Checkouts", value: "+85%" },
        { label: "Page Load Speed", value: "0.8s" },
        { label: "Cart Abandonment", value: "-34%" }
      ],
      quote: "Working with FSD felt like collaborating with high-fashion couturiers who also happen to be brilliant software architects. The launch was flawless.",
      author: "Hélène de Vance — Head of Digital, Aurelia Maison"
    },
    atlas: {
      title: "Atlas Analytics Cloud Platform",
      category: "Enterprise BI Platform & Data Visualization",
      problem: "Atlas required an enterprise telemetry dashboard capable of rendering tens of thousands of active nodes without freezing the client browser thread.",
      solution: "Architected a custom WebGL and SVG visualization pipeline combined with optimistic client queries and fine-grained role-based permissions access.",
      stack: ["React", "WebGL Shaders", "Node.js", "PostgreSQL", "Tailwind"],
      metrics: [
        { label: "Daily Active Users", value: "10,000+" },
        { label: "System Uptime", value: "99.99%" },
        { label: "Chart Render Time", value: "<16ms" },
        { label: "Enterprise Churn", value: "<0.8%" }
      ],
      quote: "The interactive speed of Atlas Analytics has turned our demo into an instant sales closure machine. FSD delivered an unmatched standard.",
      author: "Marcus Thorne — VP of Product, Atlas Cloud"
    }
  };

  // Open & Populate Modal
  function openCaseStudy(key) {
    const data = CASE_STUDIES[key];
    if (!data) return;

    document.getElementById('modalTitle').textContent = data.title;
    document.getElementById('modalCategory').textContent = data.category;
    document.getElementById('modalProblem').textContent = data.problem;
    document.getElementById('modalSolution').textContent = data.solution;
    document.getElementById('modalQuote').textContent = `"${data.quote}"`;
    document.getElementById('modalAuthor').textContent = `— ${data.author}`;

    // Render Tech Stack
    const stackContainer = document.getElementById('modalStack');
    stackContainer.innerHTML = '';
    data.stack.forEach(tech => {
      const pill = document.createElement('span');
      pill.className = 'px-2.5 py-1 rounded-md bg-surface-container font-label-caps text-[10px] text-on-surface font-semibold';
      pill.textContent = tech;
      stackContainer.appendChild(pill);
    });

    // Render Metrics
    const metricsContainer = document.getElementById('modalMetrics');
    metricsContainer.innerHTML = '';
    data.metrics.forEach(metric => {
      const card = document.createElement('div');
      card.className = 'p-2.5 rounded-lg bg-surface-container-low flex flex-col';
      card.innerHTML = `
        <span class="font-headline-sm text-[16px] text-secondary font-bold leading-tight">${metric.value}</span>
        <span class="font-label-caps text-[10px] text-on-surface-variant uppercase mt-0.5">${metric.label}</span>
      `;
      metricsContainer.appendChild(card);
    });

    // Reveal modal with animation
    const modal = document.getElementById('caseStudyModal');
    const sheet = document.getElementById('modalSheet');
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100');
    sheet.classList.remove('translate-y-full');
    sheet.classList.add('translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  // Close Modal
  function closeCaseStudy() {
    const modal = document.getElementById('caseStudyModal');
    const sheet = document.getElementById('modalSheet');
    sheet.classList.remove('translate-y-0');
    sheet.classList.add('translate-y-full');
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  // Modal backdrop click to dismiss
  document.getElementById('caseStudyModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeCaseStudy();
    }
  });

  // Filter Pill Functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle button styles
      filterButtons.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary', 'active-filter');
        b.classList.add('bg-surface-container-low', 'text-on-surface');
      });
      btn.classList.add('bg-primary', 'text-on-primary', 'active-filter');
      btn.classList.remove('bg-surface-container-low', 'text-on-surface');

      const filter = btn.getAttribute('data-filter');
      projectCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.style.display = 'flex';
          card.classList.add('animate-fadeIn');
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
